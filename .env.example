# Database. Set DATABASE_URL to a Postgres connection string (Neon, Railway, Render, Supabase, any Postgres 14+).
# Leave it unset to use the embedded PGlite Postgres, persisted to DATA_DIR (single-process deployments and local use).
# Every database command prints which of the two it is using before it touches it. Check that line.
DATABASE_URL=
DATA_DIR=./data/pglite

# Encryption for the managed database. Leave unset: hosted databases are then reached over TLS with their
# certificate checked, and a database on this machine is reached without TLS. Set it only if you must:
#   require    encrypted, certificate checked (the default for a hosted database)
#   no-verify  encrypted, certificate not checked (a provider using its own certificate authority)
#   disable    not encrypted (a database on your own machine or private network)
DATABASE_SSL=

# Session cookie encryption secret. 32 or more random characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Administrator bootstrap. Used once on first seed. Rotate the password from the admin screen after first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Public URL of the deployment (used for absolute links in exports and for secure-cookie decisions).
APP_URL=https://localhost:3443

# Self-hosted HTTPS server (npm run start:https). Not used on Vercel.
PORT=3443
TLS_KEY_PATH=./certs/dev-key.pem
TLS_CERT_PATH=./certs/dev-cert.pem

# Set DEBUG_DB=1 to make the database commands print the full technical stack trace as well as the
# plain-English explanation. Only useful when reporting a problem.
DEBUG_DB=
